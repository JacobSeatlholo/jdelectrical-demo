generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Lead {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String?
  province  String?
  service   String?
  message   String?
  source    String   @default("website")
  estimate  String?
  status    String   @default("new")
  createdAt DateTime @default(now())
}
